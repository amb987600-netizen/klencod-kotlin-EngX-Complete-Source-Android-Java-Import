<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="EngX" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ملخص القسم" android:textColor="#C8F7F1" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_open_orders" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_pm_due" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_cal_due" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_low_stock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_pending" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="أوامر · وقائية · معايرة · مخزون · اعتماد" android:textColor="#D6FFFA" android:textSize="9sp" android:gravity="center" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="افتح EngX لتفعيل الودجت" android:textColor="#FFFFFF" android:textSize="12sp" android:ellipsize="end" android:maxLines="1" />
    <LinearLayout android:id="@+id/widget_item_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/widget_item_1_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_item_1_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C8F7F1" android:textSize="10sp" /></LinearLayout>
    <LinearLayout android:id="@+id/widget_item_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/widget_item_2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_item_2_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C8F7F1" android:textSize="10sp" /></LinearLayout>
    <LinearLayout android:id="@+id/widget_item_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/widget_item_3_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_item_3_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C8F7F1" android:textSize="10sp" /></LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="آخر تحديث: —" android:textColor="#A7E8E1" android:textSize="9sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_scan" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:gravity="center" android:text="مسح" android:textColor="#00695C" android:textSize="11sp" android:textStyle="bold" android:background="#FFFFFF" />
        <TextView android:layout_width="4dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_new_order" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:gravity="center" android:text="أمر جديد" android:textColor="#00695C" android:textSize="11sp" android:textStyle="bold" android:background="#FFFFFF" />
        <TextView android:layout_width="4dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_notifications" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:gravity="center" android:text="التنبيهات" android:textColor="#00695C" android:textSize="11sp" android:textStyle="bold" android:background="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
