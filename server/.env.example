PORT=3001
DATABASE_PATH=./engx.sqlite
# Use a random secret of at least 32 characters in production; never commit it.
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173,https://localhost,capacitor://localhost
# Leave blank to disable Google sign-in; set a real OAuth client ID in production.
GOOGLE_CLIENT_ID=
BACKUP_DIR=./backups
